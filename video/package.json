{
  "name": "loomer-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "node scripts/check.ts",
    "captions": "node scripts/captions.ts",
    "audio": "node scripts/audio.ts",
    "render": "remotion render src/index.ts Demo out/demo-video-picture.mp4 --muted --concurrency=8",
    "mux": "ffmpeg -y -i out/demo-video-picture.mp4 -i out/audio.m4a -map 0:v -map 1:a -c copy -movflags +faststart out/demo-video.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "4.0.538",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
